/* pages/test/test.wxss */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header {
  text-align: center;
  padding: 40rpx 0;
  color: white;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
}

.test-results {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 30rpx 0;
  max-height: 500rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.result-item {
  padding: 20rpx;
  margin-bottom: 15rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.result-item.success {
  background: #d4edda;
  color: #155724;
  border-left: 4rpx solid #28a745;
}

.result-item.error {
  background: #f8d7da;
  color: #721c24;
  border-left: 4rpx solid #dc3545;
}

.result-item.warning {
  background: #fff3cd;
  color: #856404;
  border-left: 4rpx solid #ffc107;
}

.result-item.info {
  background: #d1ecf1;
  color: #0c5460;
  border-left: 4rpx solid #17a2b8;
}

.test-buttons {
  margin: 30rpx 0;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.4);
}

.btn-secondary {
  background: white;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}

.btn-warning {
  background: #ffc107;
  color: #333;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}

.tips {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.tip-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
  color: #333;
}

.tip-content {
  font-size: 28rpx;
  display: block;
  margin-bottom: 15rpx;
  color: #666;
  line-height: 1.6;
}