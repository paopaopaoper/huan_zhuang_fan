/* pages/index/index.wxss — 莫兰迪紫风格 */

/* ===== 全局 ===== */
.page {
  min-height: 100vh;
  background: var(--morandi-bg);
}

/* ===== 顶部品牌Hero区 ===== */
.hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 48rpx;
}
.hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(155deg, #7B6EA3 0%, #9B8EC4 35%, #B8AAD4 70%, #C9A9B4 100%);
  border-radius: 0 0 56rpx 56rpx;
}
.hero-decor {
  position: absolute;
  border-radius: 50%;
  opacity: 0.08;
  background: #fff;
}
.hero-decor-1 {
  width: 300rpx; height: 300rpx;
  top: -80rpx; right: -60rpx;
}
.hero-decor-2 {
  width: 180rpx; height: 180rpx;
  bottom: 20rpx; left: -40rpx;
}
.hero-content {
  position: relative;
  text-align: center;
  padding: 88rpx 40rpx 56rpx;
  color: #fff;
}
.logo-wrap {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255,255,255,0.15);
}
.logo-icon { font-size: 60rpx; }
.brand-name {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}
.brand-slogan {
  font-size: 28rpx;
  opacity: 0.92;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.brand-sub {
  font-size: 24rpx;
  opacity: 0.7;
  letter-spacing: 1rpx;
}

/* ===== 配额条 ===== */
.quota-bar {
  margin: -28rpx 32rpx 0;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}
.quota-left { display: flex; align-items: center; gap: 16rpx; }
.quota-icon-wrap {
  width: 64rpx; height: 64rpx;
  background: var(--morandi-tag-bg);
  border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
}
.quota-icon { font-size: 32rpx; }
.quota-info { display: flex; flex-direction: column; }
.quota-label { font-size: 28rpx; color: var(--morandi-text); font-weight: 500; }
.quota-hint { font-size: 22rpx; color: var(--morandi-text-muted); margin-top: 4rpx; }
.quota-right { display: flex; align-items: center; gap: 16rpx; }
.quota-badge {
  display: inline-flex; align-items: center;
  padding: 8rpx 20rpx;
  background: var(--morandi-tag-bg, #EDE8F5);
  border-radius: 24rpx;
  font-size: 26rpx; font-weight: 600;
  color: var(--morandi-primary-dark, #7B6EA3);
}

/* ===== 功能入口 ===== */
.feature-list {
  padding: 32rpx 32rpx 0;
}
.feature-card {
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  transition: transform 0.15s ease;
}
.feature-card:active { transform: scale(0.98); }

.card-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.tryon-icon {
  background: linear-gradient(145deg, #9B8EC4, #B8AAD4);
  box-shadow: 0 6rpx 16rpx rgba(155, 142, 196, 0.3);
}
.hair-icon {
  background: linear-gradient(145deg, #C9A9B4, #D4B8C2);
  box-shadow: 0 6rpx 16rpx rgba(201, 169, 180, 0.3);
}
.card-icon { font-size: 48rpx; }

.card-body { flex: 1; }
.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--morandi-text);
  margin-bottom: 8rpx;
}
.card-desc {
  font-size: 26rpx;
  color: var(--morandi-text-secondary);
  margin-bottom: 16rpx;
}
.card-tags { display: flex; gap: 12rpx; }
.tag {
  font-size: 22rpx;
  color: var(--morandi-tag-text);
  background: var(--morandi-tag-bg);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.card-arrow {
  margin-left: 12rpx;
  flex-shrink: 0;
}
.arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--morandi-text-muted);
  border-bottom: 3rpx solid var(--morandi-text-muted);
  transform: rotate(-45deg);
}

/* ===== 效果示范（通用） ===== */
.demo-section {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 24rpx 32rpx;
}
.demo-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.demo-title-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  letter-spacing: 2rpx;
}
.tryon-badge { background: linear-gradient(135deg, #9B8EC4, #B8AAD4); }
.hair-badge  { background: linear-gradient(135deg, #C9A9B4, #D4B8C2); }
.demo-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--morandi-text);
}

/* 上传要求提示 */
.demo-tips {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.tip-item {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 14rpx;
  background: var(--morandi-tag-bg);
  border-radius: 14rpx;
}
.tip-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.person-bg   { background: rgba(155, 142, 196, 0.15); }
.clothes-bg  { background: rgba(201, 169, 180, 0.2); }
.face-bg     { background: rgba(155, 142, 196, 0.15); }
.hair-tip-bg { background: rgba(201, 169, 180, 0.2); }
.tip-emoji { font-size: 26rpx; }
.tip-content { flex: 1; }
.tip-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--morandi-text);
  margin-bottom: 2rpx;
}
.tip-desc {
  font-size: 19rpx;
  color: var(--morandi-text-secondary);
  line-height: 1.4;
}

/* 案例展示 */
.case-showcase {
  margin-bottom: 24rpx;
}
.case-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 10rpx;
}
.case-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.case-img {
  width: 100%;
  height: 300rpx;
  border-radius: 14rpx;
  background: var(--morandi-border);
  margin-bottom: 10rpx;
  overflow: hidden;
}
/* 结果图片加高亮边框 */
.case-result {
  border: 2rpx solid var(--morandi-primary-light);
  box-shadow: 0 4rpx 16rpx rgba(155, 142, 196, 0.2);
}
.case-label {
  font-size: 20rpx;
  color: var(--morandi-text-secondary);
  font-weight: 500;
  text-align: center;
}
.case-label-result {
  color: var(--morandi-primary);
  font-weight: 600;
}
.case-arrow {
  flex-shrink: 0;
  padding: 0 2rpx;
  padding-top: 130rpx;
}
.arrow-right {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid var(--morandi-primary-light);
  border-bottom: 3rpx solid var(--morandi-primary-light);
  transform: rotate(-45deg);
}

/* 立即体验按钮 */
.demo-btn {
  width: 100% !important;
  height: 80rpx !important;
  color: #fff !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border-radius: 40rpx !important;
  border: none !important;
  letter-spacing: 2rpx;
  /* 修复文字垂直居中：用flex替代line-height */
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 1 !important;
  box-sizing: border-box !important;
}
.tryon-gradient {
  background: linear-gradient(135deg, #9B8EC4, #B8AAD4) !important;
  box-shadow: 0 8rpx 24rpx rgba(155, 142, 196, 0.35);
}
.hair-gradient {
  background: linear-gradient(135deg, #C9A9B4, #D4B8C2) !important;
  box-shadow: 0 8rpx 24rpx rgba(201, 169, 180, 0.35);
}
.demo-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ===== 获取更多次数 ===== */
.earn-section {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 28rpx;
}
.earn-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--morandi-text);
  margin-bottom: 24rpx;
}
.earn-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.earn-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.share-bg  { background: var(--morandi-tag-bg); }
.invite-bg { background: #EDE3E8; }
.earn-icon { font-size: 36rpx; }
.earn-info { flex: 1; }
.earn-action { font-size: 28rpx; color: var(--morandi-text); font-weight: 500; }
.earn-reward { font-size: 24rpx; color: var(--morandi-primary); margin-top: 4rpx; }
.earn-btn {
  height: 60rpx !important;
  line-height: 60rpx !important;
  font-size: 26rpx !important;
  padding: 0 24rpx !important;
  border-radius: 30rpx !important;
  border: none !important;
  flex-shrink: 0;
}
.share-btn { background: var(--morandi-primary) !important; color: #fff !important; }
.invite-btn { background: var(--morandi-accent) !important; color: #fff !important; }
.earn-divider {
  height: 1rpx;
  background: var(--morandi-border);
  margin: 16rpx 0;
}

/* ===== 使用流程 ===== */
.guide-section {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 28rpx;
}
.guide-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--morandi-text);
  margin-bottom: 32rpx;
}
.guide-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--morandi-gradient);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(155, 142, 196, 0.3);
}
.step-text {
  font-size: 22rpx;
  color: var(--morandi-text-secondary);
  text-align: center;
  width: 128rpx;
}
.step-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, var(--morandi-primary-lighter), var(--morandi-primary-light));
  margin: 0 12rpx;
  margin-bottom: 28rpx;
  opacity: 0.5;
}

/* ===== 底部安全距离 ===== */
.safe-bottom { height: 48rpx; }

/* ===== 登录弹窗 ===== */
.login-overlay {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}
.login-card {
  position: relative;
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 48rpx 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}
.login-header {
  text-align: center;
  margin-bottom: 48rpx;
}
.login-logo {
  font-size: 56rpx;
  display: block;
  margin-bottom: 16rpx;
}
.login-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--morandi-text);
  display: block;
  margin-bottom: 8rpx;
}
.login-subtitle {
  font-size: 26rpx;
  color: var(--morandi-text-muted);
}
.login-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.login-avatar-btn {
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50% !important;
  padding: 0 !important;
  margin: 0 !important;
  background: var(--morandi-tag-bg) !important;
  border: 3rpx dashed var(--morandi-border) !important;
  line-height: 1 !important;
  position: relative;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.login-avatar-btn::after { border: none; }
.login-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
}
.login-avatar-add {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-avatar-add-icon {
  font-size: 56rpx;
  color: var(--morandi-text-muted);
  font-weight: 300;
}
.login-avatar-label {
  font-size: 24rpx;
  color: var(--morandi-text-muted);
  margin-bottom: 32rpx;
}
.login-nickname-wrap {
  width: 100%;
  background: var(--morandi-tag-bg);
  border-radius: 16rpx;
  padding: 0 24rpx;
}
.login-nickname-input {
  height: 80rpx;
  font-size: 28rpx;
  color: var(--morandi-text);
}
.login-nickname-input::placeholder {
  color: var(--morandi-text-muted);
}
.login-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.login-confirm-btn {
  width: 100% !important;
  height: 88rpx !important;
  background: linear-gradient(135deg, #9B8EC4, #B8AAD4) !important;
  color: #fff !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  border-radius: 44rpx !important;
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 1 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(155, 142, 196, 0.35);
}
.login-confirm-btn[disabled] {
  opacity: 0.5 !important;
  box-shadow: none;
}
.login-skip {
  font-size: 26rpx;
  color: var(--morandi-text-muted);
  margin-top: 24rpx;
  padding: 8rpx 24rpx;
}
